# Backend de datos del prototipo: "json" (archivo local .data/db.json). "supabase" llega en el siguiente plan.
DATA_BACKEND=json
# Identidad: "dev" = selector "Actuar como…" sin login.
AUTH_MODE=dev

# Supabase (proyecto "Tesoreria Clubes Ultimate")
NEXT_PUBLIC_SUPABASE_URL=https://qkmjhlwovipppekpzjpb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Solo servidor/scripts. Nunca en el cliente ni en el repo.
SUPABASE_SECRET_KEY=
# Conexión directa para `npm run seed:supabase` (Dashboard → Connect → Session pooler).
SUPABASE_DB_URL=
