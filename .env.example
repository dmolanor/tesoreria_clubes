# Supabase (proyecto "Tesoreria Clubes Ultimate"). Van en .env / .env.local; en Vercel, como variables de entorno.
NEXT_PUBLIC_SUPABASE_URL=https://qkmjhlwovipppekpzjpb.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Solo servidor. Nunca en el cliente ni en el repo. La app la usa únicamente en modo demo.
SUPABASE_SECRET_KEY=

# Modo demo: "Entrar como…" en el login con una clave compartida (cuentas @example.com).
# Apagar (quitar o dejar en off) cuando entren los jugadores reales.
DEMO_MODE=on
DEMO_PASSWORD=

# Solo para `npm run seed:supabase` (Dashboard → Connect → Session pooler).
SUPABASE_DB_URL=
